<launch>
  <!-- Use a decoded bag, or leave empty for external rosbag play/live data. -->
  <arg name="direct_bag_path" default="" />
  <arg name="params_file" default="$(find sa_livo)/config/long_corridor.yaml" />
  <arg name="seq_name" default="long_corridor_lio" />
  <!-- Keep evaluation output separate for each invocation. -->
  <arg name="output_dir" default="$(find sa_livo)/Log/result/$(arg seq_name)/$(anon run)" />
  <arg name="use_rviz" default="false" />
  <node pkg="sa_livo" type="fastlivo_mapping" name="laserMapping" output="screen" required="true">
    <rosparam command="load" file="$(arg params_file)" />
    <param name="common/img_en" value="0" type="int" />
    <param name="common/direct_bag_path" value="$(arg direct_bag_path)" type="str" />
    <param name="evo/seq_name" value="$(arg seq_name)" type="str" />
    <param name="evaluation/output_dir" value="$(arg output_dir)" type="str" />
  </node>
  <node if="$(arg use_rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find sa_livo)/rviz_cfg/fast_livo2.rviz" />
</launch>
