<launch>
  <arg name="use_rviz" default="false" />
  <arg name="use_sim_time" default="false" />
  <arg name="avia_params_file" default="$(find sa_livo)/config/MARS_LVIG.yaml" />
  <arg name="camera_params_file" default="$(find sa_livo)/config/camera_MARS_LVIG.yaml" />
  <arg name="direct_bag_path" default="" />
  <param name="use_sim_time" value="$(arg use_sim_time)" />
  <node pkg="sa_livo" type="fastlivo_mapping" name="laserMapping" output="screen" required="true">
    <rosparam command="load" file="$(arg avia_params_file)" />
    <rosparam command="load" file="$(arg camera_params_file)" />
    <param name="common/direct_bag_path" value="$(arg direct_bag_path)" type="str" />
  </node>
  <node if="$(arg use_rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find sa_livo)/rviz_cfg/M300.rviz" output="screen" />
</launch>
