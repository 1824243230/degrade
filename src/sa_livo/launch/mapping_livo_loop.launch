<launch>
  <arg name="params_file" />
  <arg name="camera_params_file" />
  <arg name="direct_bag_path" default="" />
  <arg name="output_dir" />
  <arg name="loop_enabled" default="false" />
  <arg name="calibration_id" default="default" />
  <arg name="rviz_fixed_frame" default="$(eval 'map' if arg('loop_enabled') else 'camera_init')" />
  <arg name="use_rviz" default="false" />
  <arg name="use_sim_time" default="false" />
  <param name="use_sim_time" value="$(arg use_sim_time)" />
  <node pkg="sa_livo" type="fastlivo_mapping" name="laserMapping" output="screen" required="true">
    <rosparam command="load" file="$(arg params_file)" />
    <rosparam command="load" file="$(arg camera_params_file)" />
    <rosparam command="load" file="$(find sa_livo)/config/btc_loop.yaml" />
    <param name="common/img_en" value="1" />
    <param name="common/lidar_en" value="1" />
    <param name="imu/imu_en" value="true" />
    <param name="localization/enabled" value="false" />
    <param name="localization/calibration_id" value="$(arg calibration_id)" type="str" />
    <param name="common/direct_bag_path" value="$(arg direct_bag_path)" />
    <param name="evaluation/enabled" value="true" />
    <param name="evaluation/output_dir" value="$(arg output_dir)" />
    <param name="loop_closure/enabled" value="$(arg loop_enabled)" />
    <param name="loop_closure/btc_config" value="$(find btc_desc)/config/config_indoor.yaml" />
  </node>
  <node if="$(arg use_rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find sa_livo)/rviz_cfg/fast_livo2.rviz -f $(arg rviz_fixed_frame)" />
</launch>
